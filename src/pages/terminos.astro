---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { terminos } from '../data/terminos.js';
---
<Base title="Términos y condiciones" description="Términos y condiciones de compra en BULK: pedidos, precios, pagos, descuentos, envíos, cambios y datos personales.">
  <PageHead titulo="Términos y" outline="condiciones" migas={[{ href: '/terminos/', label: 'Términos y condiciones' }]} />
  <section class="section section--tight">
    <div class="wrap prose">
      {terminos.map((s, i) => (
        <>
          <h2>{i + 1}. {s.t}</h2>
          {s.p.map((txt) => <p set:html={txt} />)}
        </>
      ))}
    </div>
  </section>
</Base>
