---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import WelcomePopup from '../components/WelcomePopup.astro';
import Fab from '../components/Fab.astro';
import negocio from '../config/negocio.js';

interface Props {
  title: string;              // título de la página (sin " | BULK")
  description: string;
  image?: string;             // ruta de imagen para Open Graph
  noindex?: boolean;
  jsonLd?: object | object[]; // datos estructurados extra
  type?: 'website' | 'article' | 'product';
}
const { title, description, image = '/og.jpg', noindex = false, jsonLd, type = 'website' } = Astro.props;
const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const fullTitle = Astro.url.pathname === '/' ? `BULK · ${negocio.bajada} en Carmen de Patagones` : `${title} | BULK`;

// Negocio local: siempre presente
const d = negocio.direccion;
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  '@id': new URL('/#negocio', site).href,
  name: 'BULK — Suplementos y Nutrición Deportiva',
  url: site.href,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: d.calle,
    addressLocality: d.localidad,
    addressRegion: d.provincia,
    ...(d.codigoPostal ? { postalCode: d.codigoPostal } : {}),
    addressCountry: d.pais,
  },
  sameAs: [negocio.instagram.url],
  paymentAccepted: 'Transferencia bancaria, Efectivo',
  currenciesAccepted: 'ARS',
  ...(negocio.horariosSchema ? { openingHours: negocio.horariosSchema } : {}),
  ...(negocio.email ? { email: negocio.email } : {}),
};
const ld = [localBusiness, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
---
<!doctype html>
<html lang="es-AR" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/anybody-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type === 'product' ? 'product' : type} />
    <meta property="og:site_name" content="BULK" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <Fab />
    <CartDrawer />
    <SearchOverlay />
    <WelcomePopup />

    <script>
      // Revelado al hacer scroll (respeta prefers-reduced-motion vía CSS)
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('is-in'));
    </script>
  </body>
</html>
