---
/**
 * Wordmark BULK. Si negocio.logo tiene un archivo, se usa ese; si no, el wordmark tipográfico
 * (misma familia visual que las piezas: itálica extendida, contorno lima).
 */
import negocio from '../config/negocio.js';
interface Props { size?: 'sm' | 'md' | 'lg'; solid?: boolean }
const { size = 'md', solid = false } = Astro.props;
---
{negocio.logo ? (
  <img src={negocio.logo} alt="BULK" class:list={['wm-img', size]} width="140" height="36" />
) : (
  <span class:list={['wm', size, { solid }]} role="img" aria-label="BULK"><span aria-hidden="true">BULK</span></span>
)}
<style>
  .wm {
    display: inline-block;
    font-family: var(--f-display); font-style: italic; font-weight: 900; font-stretch: 150%;
    font-variation-settings: 'wdth' 150;
    line-height: 1; letter-spacing: 0.01em;
    color: var(--ink); -webkit-text-stroke: 1.6px var(--lime); paint-order: stroke fill;
  }
  .wm.solid { color: var(--lime); -webkit-text-stroke: 0; }
  .sm { font-size: 1.35rem; }
  .md { font-size: 1.7rem; }
  .lg { font-size: clamp(3rem, 12vw, 6rem); -webkit-text-stroke-width: 2.5px; }
  .wm-img { height: 32px; width: auto; }
  .wm-img.lg { height: 72px; }
</style>
